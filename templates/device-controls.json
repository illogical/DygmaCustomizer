      "position_id": "defy:right:r5:c7",
      "color_category": "system",
      "bazecor_action": {"type": "device-command", "command": "battery-level"}
    },
    {
      "id": "bluetooth_pairing",
      "name": "Bluetooth pairing",
      "position_l1": "Bluetooth pairing",
      "position_id": "defy:right:r5:c8",
      "color_category": "system",
      "bazecor_action": {"type": "device-command", "command": "bluetooth-pairing"}
    }
  ]
}
