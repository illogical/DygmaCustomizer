{
  "schema_version": 1,
  "id": "tmux",
  "name": "tmux panes and windows",
  "platforms": [
    "macos",
    "linux"
  ],
  "source": "https://github.com/tmux/tmux/wiki/Getting-Started (default prefix Ctrl+B; check tmux list-keys -Tprefix -N and local configuration)",
  "activation": {
    "mode": "layer-shift",
    "trigger_l1": null
  },
  "bindings": [
    {
      "id": "focus_left",
      "name": "Focus pane left",
      "position_l1": "H",
      "position_id": "defy:right:r3:c2",
      "color_category": "navigation",
      "requires_app": "tmux",
      "shortcuts": {
        "macos": [
          "Ctrl+B",
          "Left"
        ],
        "linux": [
          "Ctrl+B",
          "Left"
        ]
      }
    },
    {
      "id": "focus_down",
      "name": "Focus pane down",
      "position_l1": "J",
      "position_id": "defy:right:r3:c3",
      "color_category": "navigation",
      "requires_app": "tmux",
      "shortcuts": {
        "macos": [
          "Ctrl+B",
          "Down"
        ],
        "linux": [
          "Ctrl+B",
          "Down"
        ]
      }
    },
    {
      "id": "focus_up",
      "name": "Focus pane up",
      "position_l1": "K",
      "position_id": "defy:right:r3:c4",
      "color_category": "navigation",
      "requires_app": "tmux",
      "shortcuts": {
        "macos": [
          "Ctrl+B",
          "Up"
        ],
        "linux": [
          "Ctrl+B",
          "Up"
        ]
      }
    },
    {
      "id": "focus_right",
      "name": "Focus pane right",
      "position_l1": "L",
      "position_id": "defy:right:r3:c5",
      "color_category": "navigation",
      "requires_app": "tmux",
      "shortcuts": {
        "macos": [
          "Ctrl+B",
          "Right"
        ],
        "linux": [
          "Ctrl+B",
          "Right"
        ]
      }
    },
    {
      "id": "split_right",
      "name": "Split pane side by side",
      "position_l1": "V",
      "position_id": "defy:left:r4:c5",
      "color_category": "create",
      "requires_app": "tmux",
      "shortcuts": {
        "macos": [
          "Ctrl+B",
          "Shift+5"
        ],
        "linux": [
          "Ctrl+B",
          "Shift+5"
